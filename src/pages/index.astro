---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site.config';
import { skills, experience } from '../data/profile';
import { getPosts } from '../lib/posts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = (await getPosts('projects')).slice(0, 3);
const cases = (await getPosts('case-studies')).slice(0, 3);
const notes = (await getPosts('learning')).slice(0, 3);
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <span class="badge"><span class="dot"></span>{SITE.openTo}</span>
      <h1>Hi, I'm {SITE.shortName}.<br /><span class="gradient-text">{SITE.role}</span></h1>
      <p class="lead">{SITE.tagline}</p>
      <div class="meta-row">
        <span><Icon name="pin" color="plain" />{SITE.location}</span>
        <span><Icon name="book" color="plain" />{SITE.languages}</span>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href={`${base}/projects/`}>See my projects <Icon name="arrow" color="plain" /></a>
        {SITE.email && <a class="btn btn-ghost" href={`mailto:${SITE.email}`}><Icon name="mail" color="plain" />Contact me</a>}
        {SITE.linkedin && <a class="btn btn-ghost" href={SITE.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" color="plain" />LinkedIn</a>}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section>
    <div class="container">
      <div class="section-head"><div><h2>What I work with</h2><p>The areas I handle day to day, and where I'm growing.</p></div></div>
      <div class="skills">
        {skills.map((s) => (
          <div class="skill">
            <Icon name={s.icon} color={s.color} />
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case studies -->
  <section>
    <div class="container">
      <div class="section-head">
        <div><h2>Case studies</h2><p>Real problems from the field — symptom, cause, fix, lesson.</p></div>
        <a class="see-all" href={`${base}/case-studies/`}>See all →</a>
      </div>
      <div class="grid">
        {cases.map((p) => <PostCard href={`/case-studies/${p.id}/`} title={p.data.title} summary={p.data.summary} date={p.data.date} tags={p.data.tags} icon={p.data.icon} color={p.data.color} />)}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section>
    <div class="container">
      <div class="section-head">
        <div><h2>Projects</h2><p>What I'm building in my lab and in the cloud.</p></div>
        <a class="see-all" href={`${base}/projects/`}>See all →</a>
      </div>
      <div class="grid">
        {projects.map((p) => <PostCard href={`/projects/${p.id}/`} title={p.data.title} summary={p.data.summary} date={p.data.date} tags={p.data.tags} icon={p.data.icon} color={p.data.color} status={p.data.status} />)}
      </div>
    </div>
  </section>

  <!-- Learning -->
  <section>
    <div class="container">
      <div class="section-head">
        <div><h2>Learning log</h2><p>Latest study notes.</p></div>
        <a class="see-all" href={`${base}/learning/`}>See all →</a>
      </div>
      <div class="grid">
        {notes.map((p) => <PostCard href={`/learning/${p.id}/`} title={p.data.title} summary={p.data.summary} date={p.data.date} tags={p.data.tags} icon={p.data.icon} color={p.data.color} label={p.data.topic} />)}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section>
    <div class="container">
      <div class="section-head"><div><h2>Experience</h2><p>~3 years of enterprise IT in Korea.</p></div>
        <a class="see-all" href={`${base}/certificates/`}>Certificates & education →</a></div>
      <ul class="timeline">
        {experience.map((e) => (
          <li>
            <h3>{e.role} · {e.org}</h3>
            <span class="when">{e.when}</span>
            <p>{e.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section>
    <div class="container">
      <div class="contact-box">
        <div>
          <h2>Let's talk</h2>
          <p>Hiring for infrastructure, cloud or IT operations? I'd be glad to hear from you.</p>
        </div>
        {SITE.email && <a class="btn btn-primary" href={`mailto:${SITE.email}`}><Icon name="mail" color="plain" />{SITE.email}</a>}
      </div>
    </div>
  </section>
</Base>
