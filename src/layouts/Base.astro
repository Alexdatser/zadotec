---
// The frame around every page: header, menu, footer.
import '../styles/global.css';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.brand}` : `${SITE.name} · ${SITE.role}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/case-studies/', label: 'Case studies' },
  { href: '/learning/', label: 'Learning log' },
  { href: '/certificates/', label: 'Certificates' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav">
        <a class="logo" href={`${base}/`}>
          <img src={`${base}/favicon.svg`} alt="" />
          <span>zado<em>tec</em></span>
        </a>
        <button class="menu-btn" aria-label="Open menu" id="menu-btn">☰</button>
        <ul class="nav-links" id="nav-links">
          {links.map((l) => (
            <li><a href={`${base}${l.href}`} class={isActive(l.href) ? 'active' : ''}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} {SITE.name} · {SITE.location}</span>
        <span>Built with Astro · hosted on GitHub Pages</span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('menu-btn')?.addEventListener('click', () => {
        document.getElementById('nav-links')?.classList.toggle('open');
      });
    </script>
  </body>
</html>
