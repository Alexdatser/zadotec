---
// A clickable card used in every list (projects, case studies, learning).
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  tags?: string[];
  icon?: string;
  color?: string;
  status?: string;
  label?: string;
}
const { href, title, summary, date, tags = [], icon = 'book', color = 'blue', status, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<a class="card" href={`${base}${href}`} data-tags={tags.join('|')}>
  <div class="card-top">
    <Icon name={icon} color={color} />
    {status && <span class={`status status-${status.replace(' ', '-')}`}>{status}</span>}
    {!status && label && <span class="tag">{label}</span>}
  </div>
  <h3>{title}</h3>
  <p>{summary}</p>
  <div class="card-foot">
    <span class="date">{fmt}</span>
    {tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
  </div>
</a>
